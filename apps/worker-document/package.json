{
  "name": "@motionprep/worker-document",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --conditions=production dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/index.test.ts",
    "coverage": "node --experimental-test-coverage --test-coverage-include=src/index.ts --test-coverage-lines=75 --test-coverage-branches=50 --test-coverage-functions=100 --import tsx --test src/index.test.ts"
  },
  "dependencies": {
    "@motionprep/api": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
