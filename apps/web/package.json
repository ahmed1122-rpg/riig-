{
  "name": "@motionprep/web",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=src/**/*.{ts,tsx} --coverage.thresholds.statements=23 --coverage.thresholds.branches=26 --coverage.thresholds.functions=17 --coverage.thresholds.lines=23"
  },
  "dependencies": {
    "@motionprep/contracts": "*",
    "@motionprep/presets": "*",
    "lucide-react": "^0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
