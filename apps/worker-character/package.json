{
  "name": "@motionprep/worker-character",
  "version": "0.1.8",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --conditions=production dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/config.test.ts src/index.test.ts",
    "coverage": "node --experimental-test-coverage --test-coverage-include=src/config.ts --test-coverage-include=src/index.ts --test-coverage-lines=80 --test-coverage-branches=60 --test-coverage-functions=100 --import tsx --test src/config.test.ts src/index.test.ts"
  },
  "dependencies": {
    "@motionprep/api": "*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2"
  }
}
