{
  "name": "@motionprep/api",
  "version": "0.1.8",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./export-worker": {
      "types": "./src/exports/export-worker-runtime.ts",
      "production": "./dist/exports/export-worker-runtime.js",
      "default": "./src/exports/export-worker-runtime.ts"
    },
    "./processing-worker": {
      "types": "./src/processing/processing-worker-runtime.ts",
      "production": "./dist/processing/processing-worker-runtime.js",
      "default": "./src/processing/processing-worker-runtime.ts"
    },
    "./character-worker": {
      "types": "./src/character-rig/character-worker-runtime.ts",
      "production": "./dist/character-rig/character-worker-runtime.js",
      "default": "./src/character-rig/character-worker-runtime.ts"
    },
    "./object-storage-environment": {
      "types": "./src/storage/object-storage-environment.ts",
      "production": "./dist/storage/object-storage-environment.js",
      "default": "./src/storage/object-storage-environment.ts"
    },
    "./tracing": {
      "types": "./src/observability/tracing.ts",
      "production": "./dist/observability/tracing.js",
      "default": "./src/observability/tracing.ts"
    }
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "serve:e2e": "node --import tsx src/server.ts",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/infrastructure/postgres/migrate.ts",
    "maintenance:retention": "node --env-file-if-exists=../../.env --import tsx src/maintenance/run-retention-cleanup.ts",
    "maintenance:retention:scheduler": "node --env-file-if-exists=../../.env --import tsx src/maintenance/run-retention-scheduler.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --conditions=production dist/server.js",
    "db:migrate:prod": "node --conditions=production dist/infrastructure/postgres/migrate.js",
    "maintenance:retention:prod": "node --conditions=production dist/maintenance/run-retention-cleanup.js",
    "maintenance:retention:scheduler:prod": "node --conditions=production dist/maintenance/run-retention-scheduler.js",
    "verify:staging-dependencies:test": "node --test scripts/verify-staging-dependencies.node-test.mjs",
    "verify:staging-dependencies": "node scripts/verify-staging-dependencies.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:character-rig:race": "vitest run src/character-rig/character-generation-service.test.ts src/character-rig/character-identity-bootstrap-service.test.ts src/character-rig/character-job-executor.test.ts && vitest run --config vitest.integration.config.ts src/infrastructure/postgres/postgres-character-rig.integration.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --coverage --coverage.include=src/**/*.ts --coverage.thresholds.statements=69 --coverage.thresholds.branches=62 --coverage.thresholds.functions=71 --coverage.thresholds.lines=70"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.1",
    "@motionprep/contracts": "*",
    "@motionprep/document-processing": "*",
    "@motionprep/export-adapters": "*",
    "@motionprep/guidance": "*",
    "@motionprep/layer-domain": "*",
    "@motionprep/media-processing": "*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "fastify": "^5.4.0",
    "fflate": "^0.8.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "sharp": "^0.35.3",
    "stripe": "^22.3.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "ag-psd": "31.0.2",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
