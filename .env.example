NODE_ENV=development
API_PORT=4000
API_DEREGISTRATION_DELAY_MS=0
API_SHUTDOWN_TIMEOUT_MS=130000
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=31457280
MAX_IMAGE_UPLOAD_BYTES=31457280
UPLOAD_BODY_CONCURRENCY=3
DATABASE_URL=postgresql://motionprep:motionprep@localhost:5432/motionprep
# Optional outside production; production must use a dedicated migrator role.
MIGRATION_DATABASE_URL=
PERSISTENCE_MODE=postgres
DATABASE_POOL_MAX=10
# Migration waits are bounded; set the statement timeout to 0 only by explicit exception.
MIGRATION_ADVISORY_LOCK_TIMEOUT_MS=30000
MIGRATION_LOCK_TIMEOUT_MS=15000
MIGRATION_STATEMENT_TIMEOUT_MS=3600000
REDIS_URL=redis://localhost:6379
LOGIN_MAX_FAILURES=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=300
# Local example only. Generate a unique production key with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=bW90aW9ucHJlcC1sb2NhbC1kZXYta2V5LTMyYnl0ZXM=
# Prefer the rotatable keyring form even in durable local testing.
AUTH_ENCRYPTION_KEYRING=
AUTH_ENCRYPTION_ACTIVE_KEY_ID=
TOTP_ISSUER=MotionPrep
PASSWORD_RESET_URL=http://localhost:5173/auth/reset
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_URL=http://localhost:5173/auth
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_TOKEN_HASH=
EMAIL_DELIVERY_MODE=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_MODE=s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=motionprep-local
OBJECT_STORAGE_ACCESS_KEY=motionprep
OBJECT_STORAGE_SECRET_KEY=motionprep-local-only
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Local MinIO has no KMS. Production must use bucket-default or sse-s3.
OBJECT_STORAGE_ENCRYPTION_MODE=none
OBJECT_STORAGE_REQUIRE_VERSIONING=true
PROCESSING_EXECUTION_MODE=worker
EXPORT_EXECUTION_MODE=worker
PDF_OCR_MODE=local
PDF_REGION_OCR_ENABLED=false
CHARACTER_RIG_ENABLED=false
# Start `npm run dev:stack:character` only when a compatible local provider is
# listening here. Set CHARACTER_RIG_ENABLED=true after its heartbeat is live.
CHARACTER_INFERENCE_URL=http://127.0.0.1:8188/
CHARACTER_INFERENCE_API_KEY=local-character-provider-key
CHARACTER_INFERENCE_TIMEOUT_MS=300000
CHARACTER_INFERENCE_ALLOW_INSECURE_LOCALHOST=true
CHARACTER_POLL_MS=1000
CHARACTER_CONCURRENCY=1
CHARACTER_LEASE_MS=600000
CHARACTER_DRAIN_TIMEOUT_MS=30000
PROCESSING_POLL_MS=1000
PROCESSING_LEASE_MS=300000
PROCESSING_CONCURRENCY=2
DOCUMENT_PROCESSING_CONCURRENCY=1
RASTER_ASSET_WRITE_CONCURRENCY=2
EXPORT_POLL_MS=1000
EXPORT_CONCURRENCY=1
EXPORT_LEASE_MS=300000
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
PAYMENT_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
