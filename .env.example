NODE_ENV=development
API_PORT=4000
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=31457280
DATABASE_URL=postgresql://motionprep:motionprep@localhost:5432/motionprep
PERSISTENCE_MODE=postgres
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
LOGIN_MAX_FAILURES=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=300
# Local example only. Generate a unique production key with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=bW90aW9ucHJlcC1sb2NhbC1kZXYta2V5LTMyYnl0ZXM=
TOTP_ISSUER=MotionPrep
PASSWORD_RESET_URL=http://localhost:5173/auth/reset
EMAIL_DELIVERY_MODE=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_MODE=s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=motionprep-local
OBJECT_STORAGE_ACCESS_KEY=motionprep
OBJECT_STORAGE_SECRET_KEY=motionprep-local-only
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Local MinIO has no KMS. Production must use bucket-default or sse-s3.
OBJECT_STORAGE_ENCRYPTION_MODE=none
OBJECT_STORAGE_REQUIRE_VERSIONING=true
PROCESSING_EXECUTION_MODE=worker
EXPORT_EXECUTION_MODE=worker
PDF_OCR_MODE=local
PDF_REGION_OCR_ENABLED=true
PROCESSING_POLL_MS=1000
PROCESSING_LEASE_MS=300000
PROCESSING_CONCURRENCY=2
DOCUMENT_PROCESSING_CONCURRENCY=1
RASTER_ASSET_WRITE_CONCURRENCY=2
EXPORT_POLL_MS=1000
EXPORT_CONCURRENCY=1
EXPORT_LEASE_MS=300000
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
PAYMENT_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
