# Dedicated least-privilege identity: read/delete quarantine/* and write/read
# sources/*. It must not receive authentication, SMTP, payment, or migration secrets.
NODE_ENV=production
MOTIONPREP_WORKLOAD_IDENTITY=security
DATABASE_URL=postgresql://motionprep_security:CHANGE_ME@postgres.example.com:5432/motionprep?sslmode=verify-full
DATABASE_POOL_MAX=5
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_BUCKET=motionprep-production
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ENCRYPTION_MODE=bucket-default
OBJECT_STORAGE_REQUIRE_VERSIONING=true
MALWARE_SCANNER_HOST=clamav.internal.example.com
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=120000
MALWARE_DEFINITIONS_MAX_AGE_HOURS=24
MALWARE_SCAN_POLL_MS=1000
MALWARE_SCAN_LEASE_MS=300000
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
