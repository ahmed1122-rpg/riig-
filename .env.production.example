# Compose control plane. This file contains release coordinates and paths only;
# application credentials belong in the workload-specific secret files.
RELEASE_GIT_SHA=REPLACE_WITH_RELEASE_GIT_SHA
RUNTIME_IMAGE_REF=ghcr.io/your-org/motionprep-runtime@sha256:REPLACE_WITH_64_HEX_CHARACTERS
WEB_IMAGE_REF=ghcr.io/your-org/motionprep-web@sha256:REPLACE_WITH_64_HEX_CHARACTERS
TRUSTED_PROXY_CIDR=REPLACE_WITH_LOAD_BALANCER_SOURCE_CIDR
WEB_PORT=8080

MOTIONPREP_MIGRATION_ENV_FILE=.env.production.migrate
MOTIONPREP_API_ENV_FILE=.env.production.api
MOTIONPREP_MAINTENANCE_ENV_FILE=.env.production.maintenance
MOTIONPREP_MEDIA_WORKER_ENV_FILE=.env.production.worker-media
MOTIONPREP_DOCUMENT_WORKER_ENV_FILE=.env.production.worker-document
MOTIONPREP_EXPORT_WORKER_ENV_FILE=.env.production.worker-export
MOTIONPREP_CHARACTER_WORKER_ENV_FILE=.env.production.worker-character

# Container resource ceilings. Tune only from representative load evidence.
API_MEMORY_LIMIT=768m
MEDIA_MEMORY_LIMIT=2g
DOCUMENT_MEMORY_LIMIT=2g
EXPORT_MEMORY_LIMIT=2g
CHARACTER_MEMORY_LIMIT=2g
WEB_MEMORY_LIMIT=256m
MAINTENANCE_MEMORY_LIMIT=384m
API_CPU_LIMIT=1.0
MEDIA_CPU_LIMIT=2.0
DOCUMENT_CPU_LIMIT=2.0
EXPORT_CPU_LIMIT=2.0
CHARACTER_CPU_LIMIT=2.0
WEB_CPU_LIMIT=0.5
MAINTENANCE_CPU_LIMIT=0.5
