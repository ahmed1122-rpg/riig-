NODE_ENV=production
# Copy the exact 40-character commit from the signed release manifest.
RELEASE_GIT_SHA=REPLACE_WITH_RELEASE_GIT_SHA
API_PORT=4000
WEB_ORIGIN=https://studio.example.com
# Narrow source network used by the immediate TLS load balancer when connecting
# to port 8080. Do not use 0.0.0.0/0 or a public-client address range.
TRUSTED_PROXY_CIDR=REPLACE_WITH_LOAD_BALANCER_SOURCE_CIDR
# Nginx validates and collapses the edge chain before forwarding one client hop.
TRUST_PROXY_HOPS=1
MAX_UPLOAD_BYTES=31457280
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=true

PERSISTENCE_MODE=postgres
DATABASE_URL=postgresql://motionprep:CHANGE_ME@postgres.example.com:5432/motionprep?sslmode=verify-full
DATABASE_POOL_MAX=10

REDIS_URL=rediss://default:CHANGE_ME@redis.example.com:6379
METRICS_BEARER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Optional distributed tracing. Leave the endpoint empty to keep tracing off.
# Production rejects plaintext HTTP endpoints and URL-embedded credentials.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Store this authentication header in the deployment secret store.
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20REPLACE_WITH_COLLECTOR_TOKEN
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
LOGIN_MAX_FAILURES=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=300

# Generate with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=REPLACE_WITH_A_UNIQUE_32_BYTE_BASE64_KEY
TOTP_ISSUER=MotionPrep
PASSWORD_RESET_URL=https://studio.example.com/auth/reset

EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=security@example.com

OBJECT_STORAGE_MODE=s3
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_BUCKET=motionprep-production
# Leave credentials blank on AWS to use an IAM role / workload identity.
# Custom S3-compatible endpoints require both values. Temporary explicit
# credentials may also set OBJECT_STORAGE_SESSION_TOKEN.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
# bucket-default verifies provider-managed encryption after every write.
# Use sse-s3 to request AES256 explicitly from a compatible provider.
OBJECT_STORAGE_ENCRYPTION_MODE=bucket-default
OBJECT_STORAGE_REQUIRE_VERSIONING=true

PROCESSING_EXECUTION_MODE=worker
EXPORT_EXECUTION_MODE=worker
PDF_OCR_MODE=local
# Keep disabled until an independently sealed holdout reaches CER <= 25%.
# Disabling regional OCR does not affect ordinary PDF processing and export.
PDF_REGION_OCR_ENABLED=false
# Character Studio remains fail-closed until the private worker, provider,
# benchmark manifest, and Adobe Golden have all been approved for a release.
CHARACTER_RIG_ENABLED=false
CHARACTER_INFERENCE_URL=https://character-inference.internal/
CHARACTER_INFERENCE_API_KEY=REPLACE_WITH_SECRET_FROM_VAULT
CHARACTER_INFERENCE_TIMEOUT_MS=300000
CHARACTER_INFERENCE_ALLOW_INSECURE_LOCALHOST=false
CHARACTER_POLL_MS=1000
CHARACTER_CONCURRENCY=1
CHARACTER_LEASE_MS=600000
PROCESSING_POLL_MS=1000
PROCESSING_LEASE_MS=300000
PROCESSING_DRAIN_TIMEOUT_MS=30000
PROCESSING_CONCURRENCY=2
DOCUMENT_PROCESSING_CONCURRENCY=1
EXPORT_POLL_MS=1000
EXPORT_CONCURRENCY=1
EXPORT_LEASE_MS=300000
EXPORT_DRAIN_TIMEOUT_MS=30000
SHARP_CACHE_MEMORY_MB=64
SHARP_CONCURRENCY=2

# Container resource ceilings. Tune only after measuring representative files.
API_MEMORY_LIMIT=768m
MEDIA_MEMORY_LIMIT=2g
DOCUMENT_MEMORY_LIMIT=2g
EXPORT_MEMORY_LIMIT=2g
CHARACTER_MEMORY_LIMIT=2g
WEB_MEMORY_LIMIT=256m
MAINTENANCE_MEMORY_LIMIT=384m

# Built-in scheduler interval; the one-shot task remains available to platforms.
RETENTION_BATCH_SIZE=100
RETENTION_RUN_INTERVAL_MINUTES=60
JOB_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=400
USAGE_LEDGER_RETENTION_DAYS=400
WORKER_HEARTBEAT_RETENTION_DAYS=7
WORKER_EVENT_RETENTION_DAYS=30

# Keep disabled until Stripe keys and the webhook endpoint are configured.
PAYMENT_MODE=disabled
USAGE_METERING_MODE=shadow
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

WEB_PORT=8080
# Copy the exact digest-qualified references from the release artifact.
# Tags are intentionally unsupported by the production Compose file.
RUNTIME_IMAGE_REF=ghcr.io/your-org/motionprep-runtime@sha256:REPLACE_WITH_64_HEX_CHARACTERS
WEB_IMAGE_REF=ghcr.io/your-org/motionprep-web@sha256:REPLACE_WITH_64_HEX_CHARACTERS
