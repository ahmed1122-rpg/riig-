# Copy this file once per worker and assign a different workload identity,
# PostgreSQL role, and S3 workload identity to every copy.
NODE_ENV=production
MOTIONPREP_WORKLOAD_IDENTITY=REPLACE_WITH_WORKER_NAME
DATABASE_URL=postgresql://REPLACE_WITH_WORKER_DB_ROLE:CHANGE_ME@postgres.example.com:5432/motionprep?sslmode=verify-full
DATABASE_POOL_MAX=5
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_BUCKET=motionprep-production
# Leave blank when the platform injects a per-workload IAM identity.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ENCRYPTION_MODE=bucket-default
OBJECT_STORAGE_REQUIRE_VERSIONING=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

PROCESSING_POLL_MS=1000
PROCESSING_LEASE_MS=300000
PROCESSING_DRAIN_TIMEOUT_MS=30000
PROCESSING_CONCURRENCY=2
DOCUMENT_PROCESSING_CONCURRENCY=1
RASTER_ASSET_WRITE_CONCURRENCY=2
PDF_OCR_MODE=local
EXPORT_POLL_MS=1000
EXPORT_CONCURRENCY=1
EXPORT_LEASE_MS=300000
EXPORT_DRAIN_TIMEOUT_MS=30000
EXPORT_JOB_TIMEOUT_MS=600000
SHARP_CACHE_MEMORY_MB=64
SHARP_CONCURRENCY=2
