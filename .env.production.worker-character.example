NODE_ENV=production
MOTIONPREP_WORKLOAD_IDENTITY=character
DATABASE_URL=postgresql://motionprep_character:CHANGE_ME@postgres.example.com:5432/motionprep?sslmode=verify-full
DATABASE_POOL_MAX=5
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_BUCKET=motionprep-production
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ENCRYPTION_MODE=bucket-default
OBJECT_STORAGE_REQUIRE_VERSIONING=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
# Source-preserving compilation needs no model, GPU, or provider credential.
CHARACTER_POLL_MS=1000
CHARACTER_CONCURRENCY=1
CHARACTER_LEASE_MS=600000
CHARACTER_DRAIN_TIMEOUT_MS=30000
