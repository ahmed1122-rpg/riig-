NODE_ENV=production
MOTIONPREP_WORKLOAD_IDENTITY=api
API_PORT=4000
# Readiness deregisters first; accepted requests keep the full 120s proxy window.
API_DEREGISTRATION_DELAY_MS=10000
API_SHUTDOWN_TIMEOUT_MS=130000
WEB_ORIGIN=https://studio.example.com
TRUST_PROXY_HOPS=1
MAX_UPLOAD_BYTES=31457280
MAX_IMAGE_UPLOAD_BYTES=31457280
UPLOAD_BODY_CONCURRENCY=3
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=true

PERSISTENCE_MODE=postgres
DATABASE_URL=postgresql://motionprep_api:CHANGE_ME@postgres.example.com:5432/motionprep?sslmode=verify-full
DATABASE_POOL_MAX=10
REDIS_URL=rediss://default:CHANGE_ME@redis.example.com:6379
METRICS_BEARER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
LOGIN_MAX_FAILURES=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=300

# Keep the previous key in the ring during rotation. New secrets and recovery
# hashes use the active ID; old v1 ciphertext remains decryptable until retired.
AUTH_ENCRYPTION_KEYRING=primary:REPLACE_WITH_32_BYTE_BASE64_KEY
AUTH_ENCRYPTION_ACTIVE_KEY_ID=primary
# Optional legacy v1 key during the first rotation only; remove after the drill.
AUTH_ENCRYPTION_KEY=
TOTP_ISSUER=MotionPrep
PASSWORD_RESET_URL=https://studio.example.com/auth/reset
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_URL=https://studio.example.com/auth
# Optional one-shot bootstrap. Store only SHA-256(token), deploy once, then
# remove both values after the first administrator has enrolled MFA.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_TOKEN_HASH=
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=security@example.com

OBJECT_STORAGE_MODE=s3
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_BUCKET=motionprep-production
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ENCRYPTION_MODE=bucket-default
OBJECT_STORAGE_REQUIRE_VERSIONING=true

PROCESSING_EXECUTION_MODE=worker
EXPORT_EXECUTION_MODE=worker
PDF_OCR_MODE=local
PDF_REGION_OCR_ENABLED=false
CHARACTER_RIG_ENABLED=false

PAYMENT_MODE=disabled
USAGE_METERING_MODE=shadow
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
